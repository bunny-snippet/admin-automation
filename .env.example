DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
CONFIG_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
TRUST_PROXY_HEADERS=0
REQUIRE_REPORTED_IP_MATCH=1
BOOTSTRAP_TOKEN_MAX_AGE=300
BOOTSTRAP_RATE_LIMIT_PER_MINUTE=30

# MySQL production settings
DB_ENGINE=mysql
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=replace-with-database-password
DB_HOST=mysql.example.com
DB_PORT=3306
DB_SSL_MODE=REQUIRED
DB_SSL_CA=
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
AUTO_CREATE_PROXY_POOL_TARGETS=false
AUTO_GENERATE_PROXY_ON_DEMAND=false
AUTO_REFILL_PROXY_POOLS=false

# Zero/insufficient proxy inventory alerts (normal SMS via Twilio).
PROXY_ALERT_SMS_ENABLED=false
PROXY_ALERT_SMS_TO=+911234567890
PROXY_ALERT_COOLDOWN_SECONDS=1800
PROXY_ALERT_SMS_TIMEOUT_SECONDS=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional alternative to TWILIO_FROM_NUMBER:
TWILIO_MESSAGING_SERVICE_SID=

# Must match the Cloudflare Request Header Transform Rule value.
CLOUDFLARE_ORIGIN_SECRET=replace-with-a-long-random-secret

# Approved desktop/test-ipv6 whitelist mode.
TRUST_APP_REPORTED_IPV4=1
ADMIN_USERNAME=automation
ADMIN_EMAIL=bunnygupta578@gmail.com
ADMIN_PASSWORD=
