DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
CONFIG_ENCRYPTION_SECRET=replace-with-a-different-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
TRUST_PROXY_HEADERS=0
REQUIRE_REPORTED_IP_MATCH=1
BOOTSTRAP_TOKEN_MAX_AGE=300
BOOTSTRAP_RATE_LIMIT_PER_MINUTE=30
# Must not exceed the desktop updater's 200 MiB hard limit.
DESKTOP_RELEASE_MAX_BYTES=209715200
DESKTOP_COMPONENT_MAX_BYTES=838860800
# Optional absolute path outside any directory served as public media.
DESKTOP_RELEASE_ROOT=
# Private, signed OPTIX installer used only by the staged I-am-the-best migration agent.
OPTIX_MIGRATION_INSTALLER_PATH=
OPTIX_MIGRATION_INSTALLER_VERSION=
OPTIX_MIGRATION_INSTALLER_BUILD=0
OPTIX_MIGRATION_INSTALLER_SIZE=0
OPTIX_MIGRATION_INSTALLER_SHA256=
OPTIX_MIGRATION_INSTALLER_SIGNATURE_B64=

# MySQL production settings
DB_ENGINE=mysql
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=replace-with-database-password
DB_HOST=mysql.example.com
DB_PORT=3306
DB_SSL_MODE=REQUIRED
DB_SSL_CA=
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
AUTO_CREATE_PROXY_POOL_TARGETS=false
AUTO_GENERATE_PROXY_ON_DEMAND=false
AUTO_REFILL_PROXY_POOLS=false
PROXY_EXIT_IP_COOLDOWN_SECONDS=90000
PROXY_REFILL_STALE_SECONDS=900
PROFILE_CREATE_SERIALIZATION_ENABLED=false
OPTIX_PROXY_BRIDGE_ENABLED=true
# Set only on the Warrior server and share securely with OPTIX.
OPTIX_PROXY_BRIDGE_SECRET=

# Zero/insufficient proxy inventory alerts. Telegram has no per-message charge.
PROXY_ALERT_ENABLED=false
PROXY_ALERT_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=
# One chat ID, or comma-separated chat IDs for multiple phones/admins.
TELEGRAM_CHAT_ID=
PROXY_ALERT_COOLDOWN_SECONDS=1800
PROXY_ALERT_TIMEOUT_SECONDS=10

# Must match the Cloudflare Request Header Transform Rule value.
CLOUDFLARE_ORIGIN_SECRET=replace-with-a-long-random-secret

# Approved desktop/test-ipv6 whitelist mode.
TRUST_APP_REPORTED_IPV4=1
ADMIN_USERNAME=automation
ADMIN_EMAIL=bunnygupta578@gmail.com
ADMIN_PASSWORD=
